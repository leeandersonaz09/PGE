                  Destino
                </th>
                <th className="p-2 text-center">Profissionais</th>
              </tr>
            </thead>
            <tbody>
              {resultados.length > 0 ? (
                resultados.map((item, index) => (
                  <tr
                    key={item.id}
                    className={`border-b border-gray-100 dark:border-slate-800 transition-colors hover:bg-blue-50 dark:hover:bg-blue-900/20 ${
                      index % 2 === 0
