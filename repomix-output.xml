                                Responsável Autorizado
                              </th>
                              <th className="p-2 border-r">
                                Aluno(a) Vinculado
                              </th>
                              <th className="p-2 border-r">Série/Turma</th>
                              <th className="p-2 text-right">Data/Hora</th>
