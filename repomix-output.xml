                    <p className="text-[10px] text-slate-400 dark:text-slate-500 uppercase font-bold text-center">
                      Use um arquivo Excel ou CSV externo
                    </p>
                  </button>
                </div>
              ) : (
                <div className="max-w-4xl mx-auto">
                  <button
                    onClick={() => setOrigem(null)}
