                                <td className="p-2 text-[10px] font-bold text-slate-800 uppercase border-r">
                                  {v.nome_aluno}
                                </td>
                                <td className="p-2 text-[10px] text-slate-700 border-r">
                                  {v.serie} - {v.turma}
                                </td>
                                <td className="p-2 text-right text-[9px] text-slate-600">
                                  {v.timestamp}
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
