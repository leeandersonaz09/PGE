"use client";
import { useState } from "react";
import { supabase } from "@/lib/supabase";
import { useAuth } from "@/context/AuthContext";
import { useColigada } from "@/context/ColigadaContext";
import Swal from "sweetalert2"; // ✅ Alertas modernos
import {
  X,
  Save,
  Loader2,
  ClipboardList,
  ShieldCheck,
  User,
} from "lucide-react";

interface ModalOcorrenciaProps {
  aluno: any;
  onClose: () => void;
}

export default function ModalOcorrencia({
  aluno,
  onClose,
}: ModalOcorrenciaProps) {
  const [texto, setTexto] = useState("");
  const [salvando, setSalvando] = useState(false);
  const { user } = useAuth();
  const { coligadaAtual } = useColigada();

  const salvarOcorrencia = async () => {
    // Validações com SweetAlert2
    if (!texto.trim()) {
      return Swal.fire({
        title: "Campo Vazio",
        text: "Por favor, descreva o ocorrido antes de salvar.",
        icon: "warning",
        confirmButtonColor: "#3182ce",
      });
    }

    if (!user || !coligadaAtual) {
      return Swal.fire(
        "Erro de Sessão",
        "Usuário ou unidade não identificada.",
        "error",
      );
    }

    setSalvando(true);

    try {
      const { error } = await supabase.from("ocorrencias").insert([
        {
          aluno_id: aluno.id,
          colaborador_nome: user.user_metadata?.full_name || user.email,
          colaborador_id: user.id,
          texto: texto,
          sede_id: coligadaAtual.id, // ✅ Mantido o carimbo da sede
        },
      ]);

      if (error) throw error;

      await Swal.fire({
        title: "Sucesso!",
        text: "O registro foi gravado no prontuário do aluno.",
        icon: "success",
        confirmButtonColor: "#16a34a",
      });

      onClose();
    } catch (err: any) {
      console.error("Erro ao salvar:", err);
      Swal.fire("Falha na Gravação", err.message, "error");
    } finally {
      setSalvando(false);
    }
  };

  return (
    <div className="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[110] p-4 animate-in fade-in duration-200">
      <div className="bg-white dark:bg-slate-900 w-full max-w-lg border border-slate-200 dark:border-slate-700 shadow-2xl rounded-2xl overflow-hidden flex flex-col scale-in-center">
        {/* HEADER ESTILIZADO */}
        <div className="bg-slate-900 dark:bg-slate-800 p-4 text-white flex justify-between items-center">
          <div className="flex items-center gap-3">
            <div className="bg-blue-500 p-1.5 rounded-lg">
              <ClipboardList size={18} className="text-white" />
            </div>
            <div>
              <h2 className="text-[12px] font-black uppercase tracking-wider leading-none">
                Novo Registro de Ocorrência
              </h2>
              <p className="text-[10px] text-slate-400 font-bold mt-1">
                UNIDADE: {coligadaAtual?.sigla}
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="text-slate-400 hover:text-white hover:bg-white/10 p-1.5 rounded-full transition-all"
          >
            <X size={20} />
          </button>
        </div>

        <div className="p-6 flex flex-col gap-5">
          {/* IDENTIFICAÇÃO DO ALUNO (Visual mais limpo) */}
          <div className="bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 flex items-center gap-4">
            <div className="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-black shadow-sm">
              {aluno.nome ? aluno.nome[0] : "?"}
            </div>
            <div>
              <span className="text-slate-900 dark:text-slate-200 font-black block text-[13px] uppercase">
                {aluno.nome}
              </span>
              <span className="text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-tight">
                RA: {aluno.id} • {aluno.serie}º Ano - {aluno.turma}
              </span>
            </div>
          </div>

          <div className="space-y-2">
            <label className="text-slate-500 dark:text-slate-400 font-black text-[10px] uppercase tracking-widest flex items-center gap-2 ml-1">
              Relato Detalhado
            </label>
            <textarea
              value={texto}
              onChange={(e) => setTexto(e.target.value)}
              disabled={salvando}
              className="w-full h-48 border border-slate-200 dark:border-slate-700 p-4 text-[13px] font-medium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none resize-none bg-slate-50/30 dark:bg-slate-800/50 rounded-xl transition-all shadow-inner placeholder:text-slate-300 dark:placeholder:text-slate-500 text-slate-900 dark:text-slate-200"
              placeholder="Descreva aqui os fatos, observações ou encaminhamentos de forma profissional..."
            />
          </div>

          {/* RODAPÉ DE SEGURANÇA */}
          <div className="flex items-center justify-between px-1">
            <div className="flex items-center gap-1.5 text-[10px] text-emerald-600 dark:text-emerald-500 font-black uppercase">
              <ShieldCheck size={14} />
              Sessão Identificada:{" "}
              {user?.user_metadata?.full_name?.split(" ")[0] || "Usuário"}
            </div>
          </div>
        </div>

        {/* BOTÕES DE AÇÃO */}
        <div className="bg-slate-50 dark:bg-slate-800/50 p-4 flex justify-end gap-3 border-t border-slate-100 dark:border-slate-700">
          <button
            onClick={onClose}
            disabled={salvando}
            className="px-6 py-2.5 text-slate-500 dark:text-slate-400 font-black text-[10px] hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl uppercase transition-all"
          >
            Descartar
          </button>
          <button
            onClick={salvarOcorrencia}
            disabled={salvando}
            className="bg-slate-900 dark:bg-blue-600 hover:bg-blue-700 text-white px-8 py-2.5 rounded-xl font-black text-[10px] flex items-center gap-2 shadow-lg shadow-slate-200 dark:shadow-blue-900/50 disabled:bg-slate-400 uppercase transition-all active:scale-95"
          >
            {salvando ? (
              <>
                <Loader2 size={14} className="animate-spin" /> Gravando...
              </>
            ) : (
              <>
                <Save size={14} /> Finalizar Registro
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/app/dashboard/alunos/page.tsx">
"use client";
import { useState, useEffect, useMemo } from "react";
import { supabase } from "@/lib/supabase";
import { useAuth } from "@/context/AuthContext";
import { useColigada } from "@/context/ColigadaContext";
import { Search, Loader2, AlertCircle, Users } from "lucide-react";
import Swal from "sweetalert2";
import ModalDetalhesAluno from "@/app/dashboard/alunos/components/ModalDetalhesAluno";
import ModalOcorrencia from "@/app/dashboard/alunos/components/ModalOcorrencia";

export default function AlunosPage() {
  const { user, loading: authLoading } = useAuth();
  const { coligadaAtual, loadingColigadas } = useColigada();

  // Estados de Dados
  const [resultados, setResultados] = useState<any[]>([]);
  const [opcoesFiltro, setOpcoesFiltro] = useState<
    { serie: any; turma: string }[]
  >([]);

  // Estados de Controle (Paginação e UI)
  const [pesquisaRealizada, setPesquisaRealizada] = useState(false);
  const [dataLoading, setDataLoading] = useState(false);
  const [loadingMore, setLoadingMore] = useState(false);
  const [page, setPage] = useState(0);
  const [hasMore, setHasMore] = useState(true);

  // Filtros
  const [filtroSerie, setFiltroSerie] = useState("");
  const [filtroTurma, setFiltroTurma] = useState("");
  const [buscaNome, setBuscaNome] = useState("");

  // Modais
  const [selecionado, setSelecionado] = useState<any>(null);
  const [mostrarOcorrencia, setMostrarOcorrencia] = useState(false);

  // 1. CARREGA APENAS AS SÉRIES E TURMAS AO ABRIR A PÁGINA (SUPER LEVE)
  useEffect(() => {
    async function carregarOpcoesFiltro() {
      if (!user || !coligadaAtual) return;
      try {
        const { data } = await supabase
          .from("alunos")
          .select("serie, turma")
          .eq("sede_id", coligadaAtual.id);
        if (data) setOpcoesFiltro(data);
      } catch (err) {
        console.error(err);
      }
    }
    carregarOpcoesFiltro();
    // Reseta a tela se trocar de Sede
    setResultados([]);
    setPesquisaRealizada(false);
  }, [user, coligadaAtual]);

  // 2. MOTOR DE BUSCA COM PAGINAÇÃO NO SERVIDOR
  const fetchAlunos = async (paginaAtual: number, isNovaBusca: boolean) => {
    if (!coligadaAtual) return;
    if (isNovaBusca) setDataLoading(true);
    else setLoadingMore(true);

    try {
      let query = supabase
        .from("alunos")
        .select("*")
        .eq("sede_id", coligadaAtual.id)
        .order("nome", { ascending: true });

      // Aplica os filtros diretamente no Banco de Dados (PostgreSQL)
      if (filtroSerie) query = query.eq("serie", filtroSerie);
      if (filtroTurma) query = query.eq("turma", filtroTurma);
      if (buscaNome) query = query.ilike("nome", `%${buscaNome}%`);

      // Lógica de Paginação (Traz de 50 em 50)
      const pageSize = 50;
      const from = paginaAtual * pageSize;
      const to = from + pageSize - 1;
      query = query.range(from, to);

      const { data, error } = await query;

      if (!error && data) {
        if (isNovaBusca) {
          setResultados(data);
          if (data.length === 0) {
            Swal.fire({
              title: "Nenhum resultado",
              icon: "info",
              toast: true,
              position: "top-end",
              timer: 3000,
              showConfirmButton: false,
            });
          }
        } else {
          setResultados((prev) => [...prev, ...data]); // Junta os novos com os que já estavam na tela
        }
        // Se trouxe 50 completos, significa que tem chance de ter uma próxima página
        setHasMore(data.length === pageSize);
      }
    } catch (err) {
      console.error("Erro na busca:", err);
    } finally {
      setDataLoading(false);
      setLoadingMore(false);
    }
  };

  // Disparado ao clicar em "BUSCAR"
  const realizarBusca = () => {
    setPesquisaRealizada(true);
    setPage(0);
    setHasMore(true);
    fetchAlunos(0, true);
  };

  // Disparado quando o scroll da página rola para baixo
  useEffect(() => {
    if (page > 0) {
      fetchAlunos(page, false);
    }
  }, [page]);

  const handleScroll = (e: React.UIEvent<HTMLDivElement>) => {
    const { scrollTop, scrollHeight, clientHeight } = e.currentTarget;
    // Se chegou perto do final da tela (margem de 100px)
    if (scrollHeight - scrollTop <= clientHeight + 100) {
      if (hasMore && !loadingMore && !dataLoading) {
        setPage((prev) => prev + 1); // Dispara a busca da próxima página
      }
    }
  };

  // POPULA OS DROPDOWNS COM DADOS ÚNICOS
  const listaSeries = useMemo(() => {
    const series = opcoesFiltro.map((a) => String(a.serie));
    return Array.from(new Set(series)).sort((a, b) =>
      a.localeCompare(b, undefined, { numeric: true }),
    );
  }, [opcoesFiltro]);

  const turmasFiltradas = useMemo(() => {
    if (!filtroSerie) return [];
    return Array.from(
      new Set(
        opcoesFiltro
          .filter((a) => String(a.serie) === filtroSerie)
          .map((a) => a.turma),
      ),
    ).sort();
  }, [filtroSerie, opcoesFiltro]);

  const navegarAluno = (direcao: "anterior" | "proximo") => {
    if (!selecionado) return;
    const index = resultados.findIndex((a) => a.id === selecionado.id);
    if (direcao === "proximo" && index < resultados.length - 1)
      setSelecionado(resultados[index + 1]);
    else if (direcao === "anterior" && index > 0)
      setSelecionado(resultados[index - 1]);
  };

  if (authLoading || loadingColigadas)
    return (
      <div className="flex items-center justify-center h-full">
        <Loader2
          className="animate-spin text-blue-600 dark:text-blue-400"
          size={32}
        />
      </div>
    );

  return (
    <div className="flex flex-col h-full bg-white dark:bg-slate-900 font-sans text-[11px] text-gray-800 dark:text-slate-300">
      {/* BARRA DE FILTROS */}
      <div className="bg-slate-200 dark:bg-slate-800 p-1 flex gap-2 items-center border-b border-gray-400 dark:border-slate-700 shrink-0">
        <div className="flex items-center gap-1 px-2 border-r border-gray-400 dark:border-slate-600 mr-1">
          <span className="font-bold text-blue-700 dark:text-blue-400 uppercase">
            {coligadaAtual?.sigla}
          </span>
        </div>
        <select
          value={filtroSerie}
          onChange={(e) => {
            setFiltroSerie(e.target.value);
            setFiltroTurma("");
          }}
          className="border border-gray-400 dark:border-slate-600 rounded-sm px-1 h-6 w-32 bg-white dark:bg-slate-900 outline-none"
        >
          <option value="">Série (Todas)</option>
          {listaSeries.map((s) => (
            <option key={s} value={s}>
              {s}
            </option>
          ))}
        </select>
        <select
          value={filtroTurma}
          onChange={(e) => setFiltroTurma(e.target.value)}
          disabled={!filtroSerie}
          className="border border-gray-400 dark:border-slate-600 rounded-sm px-1 h-6 w-24 bg-white dark:bg-slate-900 outline-none disabled:opacity-50"
        >
          <option value="">Turma</option>
          {turmasFiltradas.map((t) => (
            <option key={t} value={t}>
              {t}
            </option>
          ))}
        </select>
        <input
          type="text"
          value={buscaNome}
          onChange={(e) => setBuscaNome(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && realizarBusca()}
          placeholder="Pesquisar aluno por nome..."
          className="border border-gray-400 dark:border-slate-600 rounded-sm px-2 h-6 flex-1 max-w-md bg-white dark:bg-slate-900 outline-none"
        />
        <button
          onClick={realizarBusca}
          className="bg-[#3182ce] text-white px-4 h-6 rounded-sm flex items-center gap-2 font-bold shadow-sm hover:bg-blue-600 transition-colors"
        >
          <Search size={12} /> BUSCAR
        </button>
      </div>

      {/* ÁREA DE CONTEÚDO (COM EVENTO DE SCROLL INFINITO) */}
      <div
        className="overflow-auto flex-1 bg-gray-50 dark:bg-slate-950 relative"
        onScroll={handleScroll} // ✅ Escuta a rolagem do mouse
      >
        {!pesquisaRealizada ? (
          // ✅ TELA LIMPA INICIAL PARA ECONOMIZAR MEMÓRIA
          <div className="flex flex-col items-center justify-center h-full text-slate-400 dark:text-slate-500 gap-3 animate-in fade-in">
            <div className="bg-slate-200 dark:bg-slate-800 p-4 rounded-full">
              <Users size={48} className="opacity-50" />
            </div>
            <p className="text-sm font-black uppercase tracking-widest text-slate-600 dark:text-slate-400">
             FAÇA A BUSCA PARA CARREGAR OS ALUNOS
            </p>
            <p className="text-xs max-w-md text-center">
              Utilize os filtros acima e clique em <b>Buscar</b> para localizar
              os alunos. Caso clique em buscar sem preencher nenhum filtro, todos os alunos da sede serão carregados (recomendado apenas para sedes pequenas). O sistema carrega os alunos de forma paginada, trazendo os primeiros 50 resultados e carregando mais conforme você rola a página para baixo. 
            </p>
          </div>
        ) : dataLoading ? (
          <div className="flex flex-col items-center justify-center h-full gap-2 text-blue-600 dark:text-blue-400 italic">
            <Loader2 className="animate-spin" size={24} />
            <span>Consultando banco de dados...</span>
          </div>
        ) : (
          <table className="w-full border-collapse bg-white dark:bg-slate-900">
            <thead className="sticky top-0 bg-[#f1f5f9] dark:bg-slate-800 z-10 shadow-sm">
              <tr className="border-b border-gray-300 dark:border-slate-700 font-bold text-left uppercase text-gray-600 dark:text-slate-400">
                <th className="border-r border-gray-300 dark:border-slate-700 p-2 w-14 text-center">
                  FOTO
                </th>
                <th className="border-r border-gray-300 dark:border-slate-700 p-2 w-24 text-center">
                  RA
                </th>
                <th className="border-r border-gray-300 dark:border-slate-700 p-2 px-4">
                  NOME DO ALUNO
                </th>
                <th className="border-r border-gray-300 dark:border-slate-700 p-2 w-32 text-center">
                  STATUS
                </th>
                <th className="border-r border-gray-300 dark:border-slate-700 p-2 w-32 text-center">
                  TURMA
                </th>
                <th className="p-2 w-24 text-center">SÉRIE</th>
              </tr>
            </thead>
            <tbody>
              {resultados.map((aluno, index) => (
                <tr
                  key={aluno.id}
                  onClick={() => setSelecionado(aluno)}
                  className={`hover:bg-blue-50 dark:hover:bg-blue-900/20 cursor-pointer border-b border-gray-100 dark:border-slate-800 transition-colors ${index % 2 === 0 ? "bg-white dark:bg-slate-900" : "bg-[#f8fafc] dark:bg-slate-900/50"}`}
                >
                  <td className="border-r border-gray-100 dark:border-slate-800 p-1 flex justify-center items-center">
                    <div className="w-8 h-8 rounded-full border border-gray-300 dark:border-slate-700 overflow-hidden bg-gray-200 dark:bg-slate-800 flex items-center justify-center shadow-inner">
                      {aluno.foto_url ? (
                        <img
                          src={aluno.foto_url}
                          alt="Foto"
                          className="w-full h-full object-cover"
                        />
                      ) : (
                        <span className="text-[10px] font-black text-gray-400 dark:text-slate-500">
                          {aluno.nome?.charAt(0)}
                        </span>
                      )}
                    </div>
                  </td>
                  <td className="border-r border-gray-100 dark:border-slate-800 p-1 text-center font-mono text-gray-500 dark:text-slate-500">
                    {aluno.id}
                  </td>
                  <td className="border-r border-gray-100 dark:border-slate-800 p-1 px-4 text-blue-700 dark:text-blue-400 font-bold uppercase">
                    {aluno.nome}
                  </td>
                  <td className="border-r border-gray-100 dark:border-slate-800 p-1 text-center font-bold">
                    <span
                      className={`px-2 py-0.5 rounded-full text-[10px] ${aluno.status === "CURSANDO" ? "bg-green-100 text-green-700 dark:bg-green-500/20 dark:text-green-400" : "bg-red-100 text-red-700 dark:bg-red-500/20 dark:text-red-400"}`}
                    >
                      {aluno.status}
                    </span>
                  </td>
                  <td className="border-r border-gray-100 dark:border-slate-800 p-1 text-center">
                    {aluno.turma}
                  </td>
                  <td className="p-1 text-center font-bold text-gray-600 dark:text-slate-400">
                    {aluno.serie}º Ano
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        {/* INDICADOR DE CARREGAMENTO DO INFINITE SCROLL */}
        {loadingMore && (
          <div className="py-4 flex justify-center items-center gap-2 text-blue-500 font-bold bg-white dark:bg-slate-900 border-t dark:border-slate-800">
            <Loader2 className="animate-spin" size={16} /> Carregando mais
            resultados...
          </div>
        )}
      </div>

      {selecionado && !mostrarOcorrencia && (
        <ModalDetalhesAluno
          aluno={selecionado}
          onClose={() => setSelecionado(null)}
          onNavegar={navegarAluno}
          onAbrirOcorrencias={() => setMostrarOcorrencia(true)}
        />
      )}
      {mostrarOcorrencia && selecionado && (
        <ModalOcorrencia
          aluno={selecionado}
          onClose={() => setMostrarOcorrencia(false)}
        />
      )}
    </div>
  );
}
</file>

<file path="src/app/dashboard/conselho/page.tsx">
"use client";

import { useState, useEffect, useMemo } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/lib/supabase";
import * as XLSX from "xlsx";
import {
  Upload,
  X,
  Search,
  FileSpreadsheet,
  Loader2,
  ArrowLeft,
  ArrowRight,
  Image as ImageIcon,
} from "lucide-react";

export default function ConselhoNotasPage() {
  const router = useRouter();

  // Estados Globais e Banco de Dados
  const [allStudents, setAllStudents] = useState<any[]>([]);
  const [turmas, setTurmas] = useState<string[]>([]);
  const [disciplinesOrder, setDisciplinesOrder] = useState<string[]>([]);
  const [loading, setLoading] = useState(true);
  const [isUploading, setIsUploading] = useState(false);
  const [errorMsg, setErrorMsg] = useState("");

  // Estados de Controle e Filtros
  const [currentIndex, setCurrentIndex] = useState(0);
  const [selectedTurma, setSelectedTurma] = useState("todas");
  const [mediaCorte, setMediaCorte] = useState(6.0);
  const [showStages, setShowStages] = useState(true);
  const [showExameFinal, setShowExameFinal] = useState(true);
  const [showMediaFinal, setShowMediaFinal] = useState(true);
  const [highlightStages, setHighlightStages] = useState(false);

  const [selectedDisciplines, setSelectedDisciplines] = useState<string[]>([]);
  const [disciplineFilterOpen, setDisciplineFilterOpen] = useState(false);

  // Modal de Foto
  const [modalOpen, setModalOpen] = useState(false);
  const [modalImgSrc, setModalImgSrc] = useState("");
  const [isZoomed, setIsZoomed] = useState(false);

  // --- BUSCA INICIAL NO SUPABASE ---
  useEffect(() => {
    carregarDadosDoBanco();
  }, []);

  const carregarDadosDoBanco = async () => {
    setLoading(true);
    const { data, error } = await supabase
      .from("conselho_notas")
      .select("*")
      .order("nm_pessoa", { ascending: true });

    if (error) {
      setErrorMsg("Erro ao carregar dados do banco.");
      setLoading(false);
      return;
    }

    if (data && data.length > 0) {
      reconstruirEstados(data);
    } else {
      setAllStudents([]);
    }
    setLoading(false);
  };

  const reconstruirEstados = (data: any[]) => {
    const turmasSet = new Set<string>();
    const discSet = new Set<string>();

    data.forEach((s) => {
      if (s.turma) turmasSet.add(s.turma);
      if (s.grades) {
        Object.keys(s.grades).forEach((k) => discSet.add(k));
      }
    });

    const discArray = Array.from(discSet).sort();
    setTurmas(Array.from(turmasSet).sort());
    setDisciplinesOrder(discArray);

    // Auto-selecionar disciplinas (ignorando as que você pediu no código original)
    const ignoreList = ["EDF", "PV", "SOESP", "ART.P"];
    setSelectedDisciplines(
      discArray.filter(
        (d) => !ignoreList.some((ignored) => d.includes(ignored))
      )
    );

    setAllStudents(data);
    setCurrentIndex(0);
  };

  // --- UPLOAD E PROCESSAMENTO DA PLANILHA ---
  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsUploading(true);
    setErrorMsg("");

    const reader = new FileReader();
    reader.onload = async (evt) => {
      try {
        const bstr = evt.target?.result;
        const wb = XLSX.read(bstr, { type: "binary" });
        const wsname = wb.SheetNames[0];
        const ws = wb.Sheets[wsname];
        const data = XLSX.utils.sheet_to_json(ws, { header: 1 });
        await processarESalvarNoBanco(data as any[][]);
      } catch (err) {
        console.error(err);
        setErrorMsg("Erro ao ler o arquivo Excel.");
        setIsUploading(false);
      }
    };
    reader.readAsBinaryString(file);
  };

  const processarESalvarNoBanco = async (values: any[][]) => {
    if (!values || values.length < 2) {
      setErrorMsg("A planilha parece estar vazia.");
      setIsUploading(false);
      return;
    }

    const headers = values[0].map((h) => String(h).trim().toLowerCase());

    // Mapeamento de Colunas (Idêntico ao seu original)
    const COL_ALUNO_ID = headers.indexOf("cd_aluno");
    const COL_NOME = headers.indexOf("nm_pessoa");
    const COL_FOTO = headers.indexOf("ds_link_foto");
    const COL_DISCIPLINA = headers.indexOf("disciplina");
    const COL_ETAPA1 = headers.indexOf("nota_d1");
    const COL_ETAPA2 = headers.indexOf("nota_d2");
    const COL_ETAPA3 = headers.indexOf("nota_d3");
    const COL_NOTA1 = COL_ETAPA1 > -1 ? COL_ETAPA1 : headers.indexOf("nota");
    const COL_NOTA2 = COL_ETAPA2 > -1 ? COL_ETAPA2 : headers.indexOf("rec");
    const COL_NOTA3 = COL_ETAPA3;
    const COL_MEDIA = headers.indexOf("media");
    const COL_MEDIA_FINAL = headers.indexOf("mediafinal");
    const COL_EXAME_FINAL = headers.indexOf("notaexame");
    const COL_TURMA = headers.findIndex(
      (h) => h === "ds_turma" || h === "turma"
    );

    if (COL_ALUNO_ID === -1 || COL_NOME === -1) {
      setErrorMsg("Colunas obrigatórias não encontradas: cd_aluno, nm_pessoa.");
      setIsUploading(false);
      return;
    }

    const studentsMap: Record<string, any> = {};

    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      if (!row[COL_ALUNO_ID]) continue;

      const studentId = String(row[COL_ALUNO_ID]).trim();

      if (!studentsMap[studentId]) {
        let thumbUrl =
          COL_FOTO > -1 && row[COL_FOTO] ? String(row[COL_FOTO]).trim() : "";
        let fullUrl = thumbUrl;
        if (thumbUrl.includes("width=")) {
          fullUrl = thumbUrl
            .replace(/&width=\d+/i, "&width=600")
            .replace(/&height=\d+/i, "&height=875");
        }

        studentsMap[studentId] = {
          cd_aluno: studentId,
          nm_pessoa: String(row[COL_NOME]).trim(),
          foto_url: thumbUrl,
          full_foto_url: fullUrl,
          turma:
            COL_TURMA > -1 ? String(row[COL_TURMA] || "Geral").trim() : "Geral",
          grades: {},
        };
      }

      let disciplina =
        COL_DISCIPLINA > -1 ? String(row[COL_DISCIPLINA] || "").trim() : "";
      disciplina = disciplina.replace(/^"|"$/g, "").toUpperCase();
      if (!disciplina || disciplina === "---") continue;

      studentsMap[studentId].grades[disciplina] = {
        etapa1: COL_NOTA1 > -1 ? row[COL_NOTA1] : "",
        etapa2: COL_NOTA2 > -1 ? row[COL_NOTA2] : "",
        etapa3: COL_NOTA3 > -1 ? row[COL_NOTA3] : "",
        mf_original:
          COL_MEDIA > -1
            ? row[COL_MEDIA]
            : COL_MEDIA_FINAL > -1
            ? row[COL_MEDIA_FINAL]
            : "",
        mf_exame: COL_EXAME_FINAL > -1 ? row[COL_EXAME_FINAL] : "",
      };
    }

    const alunosParaSalvar = Object.values(studentsMap);

    // 1. Apaga tudo que existe no banco (O Wipe que você pediu)
    await supabase
      .from("conselho_notas")
      .delete()
      .neq("id", "00000000-0000-0000-0000-000000000000");

    // 2. Insere os novos dados (em lotes para não sobrecarregar)
    const { error } = await supabase
      .from("conselho_notas")
      .insert(alunosParaSalvar);

    if (error) {
      setErrorMsg("Erro ao salvar no banco de dados.");
      console.error(error);
    } else {
      await carregarDadosDoBanco(); // Recarrega a tela com os dados salvos
    }

    setIsUploading(false);
  };

  // --- FUNÇÕES AUXILIARES E FILTROS ---
  const safeParseFloat = (val: any) => {
    if (typeof val === "number") return val;
    if (val === undefined || val === null) return null;
    const str = String(val).trim();
    if (str === "" || str === "---" || str === "-") return null;
    const num = parseFloat(str.replace(",", "."));
    return isNaN(num) ? null : num;
  };

  const filteredStudents = useMemo(() => {
    if (allStudents.length === 0) return [];
    let temp = allStudents;

    if (selectedTurma !== "todas") {
      temp = temp.filter((s) => s.turma === selectedTurma);
    }

    temp = temp.filter((student) => {
      if (!student.grades) return false;
      return selectedDisciplines.some((subject) => {
        const gradeInfo = student.grades[subject];
        if (!gradeInfo) return false;

        let rawValue = showExameFinal
          ? gradeInfo.mf_exame
          : showMediaFinal
          ? gradeInfo.mf_original
          : null;
        const num = safeParseFloat(rawValue);
        return num !== null && num < mediaCorte;
      });
    });

    return temp;
  }, [
    allStudents,
    selectedTurma,
    mediaCorte,
    selectedDisciplines,
    showExameFinal,
    showMediaFinal,
  ]);

  useMemo(() => {
    if (currentIndex >= filteredStudents.length && filteredStudents.length > 0)
      setCurrentIndex(0);
  }, [filteredStudents.length]);

  const formatGrade = (value: any, applyRedClass: boolean) => {
    const num = safeParseFloat(value);
    if (num === null)
      return {
        value: (
          <span className="text-gray-400 dark:text-slate-500 italic">-</span>
        ),
        className: "",
      };

    const displayVal = num.toFixed(1).replace(".", ",");
    let className = "font-medium ";
    if (applyRedClass && num < mediaCorte)
      className +=
        "bg-red-100 dark:bg-red-500/20 text-red-700 dark:text-red-400 px-2 py-0.5 rounded";

    return { value: displayVal, className };
  };

  const currentStudent = filteredStudents[currentIndex];
  let statusCount = 0;

  if (currentStudent) {
    selectedDisciplines.forEach((subject) => {
      const g = currentStudent.grades[subject];
      if (!g) return;
      let rawValue = showExameFinal
        ? g.mf_exame
        : showMediaFinal
        ? g.mf_original
        : null;
      const num = safeParseFloat(rawValue);
      if (num !== null && num < mediaCorte) statusCount++;
    });
  }

  return (
    <div className="flex flex-col h-full bg-[#f1f5f9] dark:bg-slate-950 font-sans overflow-hidden">
      {/* BARRA SUPERIOR DE CONTROLES */}
      <div className="bg-white dark:bg-slate-900 p-3 border-b dark:border-slate-800 flex flex-wrap gap-4 items-center justify-between shadow-sm z-10 shrink-0">
        {/* Upload e Turma */}
        <div className="flex items-center gap-4">
          <label className="flex items-center gap-2 bg-[#0d9488] hover:bg-teal-700 text-white px-4 py-1.5 rounded-md cursor-pointer text-xs font-bold transition-colors">
            {isUploading ? (
              <Loader2 size={16} className="animate-spin" />
            ) : (
              <Upload size={16} />
            )}
            {isUploading ? "Processando..." : "Subir Nova Planilha"}
            <input
              type="file"
              accept=".xlsx, .xls, .csv"
              onChange={handleFileUpload}
              className="hidden"
              disabled={isUploading}
            />
          </label>

          <div className="flex items-center gap-2">
            <label className="text-xs font-bold text-gray-700 dark:text-slate-300">
              Turma:
            </label>
            <select
              value={selectedTurma}
              onChange={(e) => setSelectedTurma(e.target.value)}
              className="border dark:border-slate-700 rounded px-2 py-1 text-xs bg-gray-50 dark:bg-slate-800 text-gray-800 dark:text-slate-200 outline-none"
            >
              <option value="todas">Todas</option>
              {turmas.map((t) => (
                <option key={t} value={t}>
                  {t}
                </option>
              ))}
            </select>
          </div>
        </div>

        {/* Filtros de Notas */}
        <div className="flex items-center gap-4 text-xs">
          <div className="flex items-center gap-2">
            <label className="font-bold text-gray-700 dark:text-slate-300">
              Média Corte:
            </label>
            <input
              type="number"
              value={mediaCorte}
              step="0.1"
              onChange={(e) => setMediaCorte(parseFloat(e.target.value))}
              className="border dark:border-slate-700 rounded w-16 px-2 py-1 bg-gray-50 dark:bg-slate-800 text-gray-800 dark:text-slate-200 outline-none"
            />
          </div>

          <label className="flex items-center gap-1 cursor-pointer select-none text-gray-700 dark:text-slate-300">
            <input
              type="checkbox"
              checked={showExameFinal}
              onChange={(e) => setShowExameFinal(e.target.checked)}
              className="dark:accent-teal-500"
            />{" "}
            Exame Final
          </label>
          <label className="flex items-center gap-1 cursor-pointer select-none text-gray-700 dark:text-slate-300">
            <input
              type="checkbox"
              checked={showMediaFinal}
              onChange={(e) => setShowMediaFinal(e.target.checked)}
              className="dark:accent-teal-500"
            />{" "}
            Média Final
          </label>
          <label className="flex items-center gap-1 cursor-pointer select-none text-gray-700 dark:text-slate-300">
            <input
              type="checkbox"
              checked={showStages}
              onChange={(e) => setShowStages(e.target.checked)}
              className="dark:accent-teal-500"
            />{" "}
            Etapas
          </label>
        </div>

        {/* Fechar */}
        <button
          onClick={() => router.push("/dashboard")}
          className="flex items-center gap-1 text-xs font-bold text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 px-3 py-1.5 rounded-md transition-colors"
        >
          <X size={16} /> Fechar
        </button>
      </div>

      {/* ÁREA PRINCIPAL (Flex-1 e hidden para travar a tela) */}
      <div className="flex-1 overflow-hidden p-4 flex flex-col items-center justify-center">
        {loading ? (
          <div className="flex flex-col items-center justify-center h-full text-[#0d9488] dark:text-teal-400 gap-2">
            <Loader2 size={32} className="animate-spin" />
            <p className="font-bold text-sm">Carregando dados do banco...</p>
          </div>
        ) : errorMsg ? (
          <div className="bg-red-100 dark:bg-red-900/20 border border-red-400 dark:border-red-800/50 text-red-700 dark:text-red-300 px-4 py-3 rounded relative">
            <strong className="font-bold">Erro: </strong>
            <span className="block sm:inline">{errorMsg}</span>
          </div>
        ) : allStudents.length === 0 ? (
          <div className="flex flex-col items-center justify-center h-full text-gray-400 dark:text-slate-500 gap-4">
            <FileSpreadsheet size={64} className="opacity-50" />
            <h2 className="text-xl font-bold text-gray-600 dark:text-slate-400">
              Nenhum dado encontrado
            </h2>
            <p className="text-sm text-center max-w-md">
              Faça o upload da planilha do sistema para alimentar o banco de
              dados do Conselho de Classe.
            </p>
          </div>
        ) : filteredStudents.length === 0 ? (
          <div className="text-center text-gray-500 dark:text-slate-400 font-medium">
            Nenhum aluno encontrado com pendências nas turmas/disciplinas
            selecionadas.
          </div>
        ) : currentStudent ? (
          /* =========================================================
             AQUI ESTÁ A CORREÇÃO PRINCIPAL (Flex, Col e Max-H)
          ========================================================= */
          <div className="w-full max-w-5xl bg-white dark:bg-slate-800 rounded-xl shadow-md border border-gray-200 dark:border-slate-700 overflow-hidden flex flex-col h-full max-h-full">
            {/* Cabeçalho do Card (Shrink-0 para não amassar) */}
            <div className="bg-gradient-to-r from-[#0d9488] to-teal-800 p-6 flex gap-6 items-center text-white shrink-0">
              <div
                className="w-24 h-24 rounded-full bg-white dark:bg-slate-700 border-4 border-teal-200 dark:border-teal-600 overflow-hidden cursor-pointer shadow-inner flex-shrink-0 relative group"
                onClick={() => {
                  setModalImgSrc(
                    currentStudent.full_foto_url || currentStudent.foto_url
                  );
                  setModalOpen(true);
                }}
              >
                {currentStudent.foto_url ? (
                  <img
                    src={currentStudent.foto_url}
                    alt="Foto"
                    className="w-full h-full object-cover group-hover:scale-110 transition-transform"
                  />
                ) : (
                  <div className="w-full h-full flex items-center justify-center text-gray-400 dark:text-slate-500">
                    <ImageIcon size={32} />
                  </div>
                )}
                <div className="absolute inset-0 bg-black/20 hidden group-hover:flex items-center justify-center transition-all">
                  <Search size={20} />
                </div>
              </div>

              <div className="flex-1">
                <h2 className="text-3xl font-bold tracking-tight mb-1">
                  {currentStudent.nm_pessoa}
                </h2>
                <div className="flex items-center gap-3 text-sm font-medium text-teal-100">
                  <span className="bg-black/20 px-3 py-1 rounded-full">
                    RA: {currentStudent.cd_aluno}
                  </span>
                  <span className="bg-black/20 px-3 py-1 rounded-full">
                    {currentStudent.turma}
                  </span>
                </div>
              </div>

              <div className="text-right">
                <div className="text-sm text-teal-100 font-bold mb-1">
                  Status de Recuperação
                </div>
                {statusCount >= 5 ? (
                  <div className="bg-red-500 text-white font-bold px-4 py-2 rounded-lg shadow-sm border border-red-400">
                    Recuperação ({statusCount})
                  </div>
                ) : (
                  <div className="bg-green-500 text-white font-bold px-4 py-2 rounded-lg shadow-sm border border-green-400">
                    Conselho ({statusCount})
                  </div>
                )}
              </div>
            </div>

            {/* Tabela de Notas (Flex-1 e Overflow-auto para rolar DENTRO) */}
            <div className="p-0 overflow-auto flex-1 bg-white dark:bg-slate-800 relative">
              <table className="w-full text-left text-sm text-gray-700 dark:text-slate-300 border-collapse">
                {/* Thead com Sticky Top e Bg para grudar no topo */}
                <thead className="bg-gray-50 dark:bg-slate-900 uppercase text-[10px] font-bold text-gray-500 dark:text-slate-400 sticky top-0 z-10 shadow-sm">
                  <tr>
                    <th className="px-6 py-3 border-b border-r border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
                      Disciplina
                    </th>
                    {showStages && (
                      <th className="px-4 py-3 border-b border-r border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 text-center">
                        Etapa 1
                      </th>
                    )}
                    {showStages && (
                      <th className="px-4 py-3 border-b border-r border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 text-center">
                        Etapa 2
                      </th>
                    )}
                    {showStages && (
                      <th className="px-4 py-3 border-b border-r border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 text-center">
                        Etapa 3
                      </th>
                    )}
                    {showExameFinal && (
                      <th className="px-4 py-3 border-b border-r border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 text-center">
                        Exame Final
                      </th>
                    )}
                    {showMediaFinal && (
                      <th className="px-4 py-3 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 text-center">
                        Média Final
                      </th>
                    )}
                  </tr>
                </thead>
                <tbody>
                  {disciplinesOrder.map((subject, idx) => {
                    const g = currentStudent.grades[subject];
                    if (!g) return null;

                    const isCalculated = selectedDisciplines.includes(subject);
                    const d1 = formatGrade(g.etapa1, highlightStages);
                    const d2 = formatGrade(g.etapa2, highlightStages);
                    const d3 = formatGrade(g.etapa3, highlightStages);
                    const mf_orig = formatGrade(g.mf_original, true);
                    const mf_exam = formatGrade(g.mf_exame, true);

                    return (
                      <tr
                        key={subject}
                        className={`border-b border-gray-100 dark:border-slate-700/50 ${
                          idx % 2 === 0
                            ? "bg-white dark:bg-slate-800"
                            : "bg-gray-50/50 dark:bg-slate-800/50"
                        } ${
                          !isCalculated
                            ? "opacity-40 grayscale"
                            : "hover:bg-teal-50 dark:hover:bg-teal-900/20"
                        }`}
                      >
                        <td className="px-6 py-2 border-r border-gray-100 dark:border-slate-700/50 font-bold text-gray-800 dark:text-slate-200">
                          {subject}{" "}
                          {!isCalculated && (
                            <span className="text-[9px] font-normal text-gray-400 dark:text-slate-500 ml-2 border dark:border-slate-600 px-1 rounded">
                              Ignorada
                            </span>
                          )}
                        </td>
                        {showStages && (
                          <td
                            className={`px-4 py-2 border-r border-gray-100 dark:border-slate-700/50 text-center ${d1.className}`}
                          >
                            {d1.value}
                          </td>
                        )}
                        {showStages && (
                          <td
                            className={`px-4 py-2 border-r border-gray-100 dark:border-slate-700/50 text-center ${d2.className}`}
                          >
                            {d2.value}
                          </td>
                        )}
                        {showStages && (
                          <td
                            className={`px-4 py-2 border-r border-gray-100 dark:border-slate-700/50 text-center ${d3.className}`}
                          >
                            {d3.value}
                          </td>
                        )}
                        {showExameFinal && (
                          <td
                            className={`px-4 py-2 border-r border-gray-100 dark:border-slate-700/50 text-center ${mf_exam.className}`}
                          >
                            {mf_exam.value}
                          </td>
                        )}
                        {showMediaFinal && (
                          <td
                            className={`px-4 py-2 text-center ${mf_orig.className}`}
                          >
                            {mf_orig.value}
                          </td>
                        )}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {/* Paginação (Shrink-0 para nunca sumir embaixo) */}
            <div className="bg-gray-50 dark:bg-slate-900/50 p-4 border-t dark:border-slate-700 flex items-center justify-between shrink-0">
              <button
                onClick={() => setCurrentIndex((prev) => prev - 1)}
                disabled={currentIndex === 0}
                className="flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm text-sm font-bold text-gray-700 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <ArrowLeft size={16} /> Anterior
              </button>

              <div className="text-sm font-bold text-gray-600 dark:text-slate-400">
                Aluno{" "}
                <span className="text-[#0d9488] dark:text-teal-400 text-lg">
                  {currentIndex + 1}
                </span>{" "}
                de {filteredStudents.length}
              </div>

              <button
                onClick={() => setCurrentIndex((prev) => prev + 1)}
                disabled={currentIndex === filteredStudents.length - 1}
                className="flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-600 rounded-md shadow-sm text-sm font-bold text-gray-700 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Próximo <ArrowRight size={16} />
              </button>
            </div>
          </div>
        ) : null}
      </div>

      {/* MODAL DA IMAGEM ZOOM */}
      {modalOpen && (
        <div
          className="fixed inset-0 bg-black/80 z-[100] flex items-center justify-center p-4 cursor-zoom-out"
          onClick={() => setModalOpen(false)}
        >
          <img
            src={modalImgSrc}
            className={`max-w-full max-h-full rounded-lg shadow-2xl transition-transform ${
              isZoomed ? "scale-125" : "scale-100"
            }`}
            onClick={(e) => {
              e.stopPropagation();
              setIsZoomed(!isZoomed);
            }}
            style={{ cursor: isZoomed ? "zoom-out" : "zoom-in" }}
            alt="Zoom do aluno"
          />
          <button
            onClick={() => setModalOpen(false)}
            className="absolute top-6 right-6 text-white hover:text-red-500 bg-black/50 hover:bg-black/80 rounded-full p-2 transition-colors"
          >
            <X size={32} />
          </button>
        </div>
      )}
    </div>
  );
}
