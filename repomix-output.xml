                    <p className="text-[7px] text-slate-500 uppercase mt-1">
                      Este sorteio foi processado de forma aleatória e
                      auditável.
                    </p>
                  </div>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </>
  );
}
