  const [sedeSelecionada, setSedeSelecionada] = useState("");
  const [novoEquipNome, setNovoEquipNome] = useState("");
  const [novoEquipQtd, setNovoEquipQtd] = useState(1);

  useEffect(() => {
    if (coligadaAtual) setSedeSelecionada(String(coligadaAtual.id));
  }, [coligadaAtual]);

  useEffect(() => {
    if (sedeSelecionada) carregarEquipamentosPorSede(Number(sedeSelecionada));
    else setEquipamentos([]);
  }, [sedeSelecionada]);

  async function carregarEquipamentosPorSede(idSede: number) {
    const { data } = await supabase
      .from("equipamentos")
      .select("*")
      .eq("sede_id", idSede)
      .order("nome");
    if (data) setEquipamentos(data);
  }

  const adicionarEquipamento = async () => {
    if (!novoEquipNome || !sedeSelecionada)
      return Swal.fire(
        "Atenção",
        "Preencha o nome e selecione a sede.",
        "warning",
      );

    const { error } = await supabase.from("equipamentos").insert([
      {
        nome: novoEquipNome,
        quantidade_total: novoEquipQtd,
        sede_id: Number(sedeSelecionada),
      },
    ]);

    if (!error) {
      // ✅ LOG DE AUDITORIA AQUI
      await registrarLog(
        nomeUsuario,
        "CADASTRO DE EQUIPAMENTO",
        `Adicionou ${novoEquipQtd}x '${novoEquipNome}' ao inventário da Sede ${sedeSelecionada}.`,
      );

      setNovoEquipNome("");
      carregarEquipamentosPorSede(Number(sedeSelecionada));
      Swal.fire({
        title: "Salvo!",
        icon: "success",
        toast: true,
        position: "top-end",
        timer: 2000,
        showConfirmButton: false,
      });
    }
  };

  // ✅ Modificado para receber o nome também
  const deletarEquipamento = async (id: string, nomeEquip: string) => {
    const result = await Swal.fire({
      title: "Apagar Dispositivo?",
      text: "Remover da unidade?",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      confirmButtonText: "Sim, remover!",
    });
    if (result.isConfirmed) {
      await supabase.from("equipamentos").delete().eq("id", id);

      // ✅ LOG DE AUDITORIA AQUI
      await registrarLog(
        nomeUsuario,
        "EXCLUSÃO DE EQUIPAMENTO",
        `Removeu o dispositivo '${nomeEquip}' da unidade.`,
      );

      carregarEquipamentosPorSede(Number(sedeSelecionada));
      Swal.fire("Removido!", "Item excluído.", "success");
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b dark:border-slate-800 pb-4">
        <h2 className="text-lg font-black uppercase text-slate-800 dark:text-slate-200 flex items-center gap-2">
          <Laptop className="text-indigo-500" /> Dispositivos de Locação
        </h2>
        <select
          value={sedeSelecionada}
          onChange={(e) => setSedeSelecionada(e.target.value)}
          className="border border-slate-300 dark:border-slate-700 rounded-lg p-2 text-xs font-bold bg-white dark:bg-slate-900 outline-none focus:border-indigo-500"
        >
          <option value="">Selecione a sede...</option>
          {sedes.map((s) => (
            <option key={s.id} value={s.id}>
              {s.nome}
            </option>
          ))}
        </select>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div className="bg-slate-50 dark:bg-slate-800/30 p-6 border dark:border-slate-800 rounded-2xl h-fit space-y-4">
          <h3 className="text-[10px] font-black text-slate-500 uppercase">
            Cadastrar Novo Item
          </h3>
          <input
            type="text"
            placeholder="Ex: Projetor Epson"
            value={novoEquipNome}
            onChange={(e) => setNovoEquipNome(e.target.value)}
            className="w-full border dark:border-slate-700 p-3 text-sm rounded-xl bg-white dark:bg-slate-900 outline-none focus:border-indigo-500 placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-slate-200"
          />
          <input
            type="number"
            min="1"
            value={novoEquipQtd}
            onChange={(e) => setNovoEquipQtd(Number(e.target.value))}
            className="w-full border dark:border-slate-700 p-3 text-sm rounded-xl bg-white dark:bg-slate-900 outline-none focus:border-indigo-500 placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-slate-200"
          />
          <button
            onClick={adicionarEquipamento}
            className="bg-indigo-600 hover:bg-indigo-700 text-white font-black text-[10px] uppercase tracking-widest px-4 py-4 rounded-xl w-full transition-all flex justify-center items-center gap-2"
          >
            <PlusCircle size={16} /> Adicionar ao Inventário
          </button>
        </div>

        <div className="md:col-span-2 overflow-x-auto border dark:border-slate-800 rounded-2xl">
          <table className="w-full text-left text-sm min-w-[300px]">
            <thead className="bg-slate-50 dark:bg-slate-800/50 border-b dark:border-slate-800 text-slate-500 text-[10px] font-bold uppercase">
              <tr>
                <th className="p-4">Equipamento</th>
                <th className="p-4 text-center">Quantidade</th>
                <th className="p-4 text-center">Ação</th>
              </tr>
            </thead>
            <tbody className="divide-y dark:divide-slate-800">
              {equipamentos.map((eq) => (
                <tr
                  key={eq.id}
                  className="hover:bg-slate-50 dark:hover:bg-slate-800/30"
                >
                  <td className="p-4 font-bold text-slate-700 dark:text-slate-300">
                    {eq.nome}
                  </td>
                  <td className="p-4 text-center font-black text-indigo-600 dark:text-indigo-400">
                    {eq.quantidade_total}
                  </td>
                  <td className="p-4 text-center">
                    <button
                      onClick={() => deletarEquipamento(eq.id, eq.nome)} // ✅ Passando o nome agora
                      className="text-red-500 hover:bg-red-50 dark:hover:bg-red-900/30 p-2 rounded-lg transition-all"
                    >
                      <Trash2 size={18} />
                    </button>
                  </td>
                </tr>
              ))}
              {equipamentos.length === 0 && (
                <tr>
                  <td
                    colSpan={3}
                    className="p-8 text-center text-slate-400 text-xs font-bold uppercase"
                  >
                    Nenhum equipamento cadastrado nesta sede.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/app/dashboard/admin/GestaoSedes.tsx">
"use client";

import { useState } from "react";
import { supabase } from "@/lib/supabase";
import { useAuth } from "@/context/AuthContext"; // ✅ Adicionado
import { registrarLog } from "@/lib/audit"; // ✅ Adicionado
import Swal from "sweetalert2";
import { Building2, PlusCircle, Trash2 } from "lucide-react";

export default function GestaoSedes({
  sedes,
  recarregar,
}: {
  sedes: any[];
  recarregar: () => void;
}) {
  const { user } = useAuth(); // ✅ Adicionado
  const nomeUsuario =
    user?.user_metadata?.full_name ||
    user?.user_metadata?.name ||
    "Administrador"; // ✅ Adicionado

  const [novoId, setNovoId] = useState("");
  const [novoNome, setNovoNome] = useState("");
  const [novaSigla, setNovaSigla] = useState("");

  const adicionarSede = async () => {
    if (!novoId || !novoNome || !novaSigla) {
      return Swal.fire(
        "Atenção",
        "Preencha todos os campos da nova unidade.",
        "warning",
      );
    }

    const { error } = await supabase
      .from("sedes")
      .insert([
        { id: Number(novoId), nome: novoNome, sigla: novaSigla.toUpperCase() },
      ]);

    if (!error) {
      // ✅ LOG DE AUDITORIA AQUI
      await registrarLog(
        nomeUsuario,
        "NOVA UNIDADE (SEDE)",
        `Cadastrou a unidade '${novoNome}' com o ID ${novoId} e Sigla ${novaSigla.toUpperCase()}.`,
      );

      setNovoId("");
      setNovoNome("");
      setNovaSigla("");
      recarregar();
      Swal.fire({
        title: "Salvo!",
        icon: "success",
        toast: true,
        position: "top-end",
        timer: 2000,
        showConfirmButton: false,
      });
    } else {
      Swal.fire(
        "Erro",
        "Pode já existir uma unidade com este Código ID.",
        "error",
      );
    }
  };

  // ✅ Modificado para receber o nome da sede para gravar no log
  const deletarSede = async (id: number, nomeSede: string) => {
    const result = await Swal.fire({
      title: "Apagar Unidade?",
      text: "Isso pode afetar alunos e equipamentos vinculados. Tem a certeza?",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      confirmButtonText: "Sim, remover!",
    });

    if (result.isConfirmed) {
      const { error } = await supabase.from("sedes").delete().eq("id", id);
      if (error) {
        Swal.fire(
          "Erro",
          "Não é possível apagar sedes que já possuem alunos vinculados.",
          "error",
        );
      } else {
        // ✅ LOG DE AUDITORIA AQUI
        await registrarLog(
          nomeUsuario,
          "EXCLUSÃO DE UNIDADE (SEDE)",
          `Removeu permanentemente a unidade '${nomeSede}' (ID: ${id}).`,
        );

        recarregar();
        Swal.fire("Removido!", "Unidade escolar removida.", "success");
      }
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex items-center gap-2 border-b dark:border-slate-800 pb-4">
        <Building2 className="text-blue-500" />
        <h2 className="text-lg font-black uppercase text-slate-800 dark:text-slate-200">
          Unidades do Sistema (Multi-Tenant)
        </h2>
      </div>

      <div className="grid grid-cols-1 xl:grid-cols-3 gap-8">
        <div className="bg-slate-50 dark:bg-slate-800/30 p-6 border dark:border-slate-800 rounded-2xl h-fit space-y-4 shadow-inner">
          <h3 className="text-[10px] font-black text-slate-500 uppercase tracking-widest">
            Nova Unidade
          </h3>
          <input
            type="number"
            placeholder="ID/Código (Ex: 1219)"
            value={novoId}
            onChange={(e) => setNovoId(e.target.value)}
            className="w-full border dark:border-slate-700 p-3 text-sm rounded-xl bg-white dark:bg-slate-900 outline-none focus:border-blue-500 placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-slate-200"
          />
          <input
            type="text"
            placeholder="Nome Completo (Ex: Pituba)"
            value={novoNome}
            onChange={(e) => setNovoNome(e.target.value)}
            className="w-full border dark:border-slate-700 p-3 text-sm rounded-xl bg-white dark:bg-slate-900 outline-none focus:border-blue-500 placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-slate-200"
          />
          <input
            type="text"
            placeholder="Sigla (Ex: PTB)"
            value={novaSigla}
            onChange={(e) => setNovaSigla(e.target.value)}
            maxLength={5}
            className="w-full border dark:border-slate-700 p-3 text-sm rounded-xl bg-white dark:bg-slate-900 outline-none focus:border-blue-500 uppercase placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-slate-200"
          />
          <button
            onClick={adicionarSede}
            className="bg-blue-600 hover:bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest px-4 py-4 rounded-xl w-full transition-all flex justify-center gap-2"
          >
            <PlusCircle size={16} /> Cadastrar Sede
          </button>
        </div>

        <div className="xl:col-span-2 overflow-x-auto border dark:border-slate-800 rounded-2xl">
          <table className="w-full text-left text-sm min-w-[400px]">
            <thead className="bg-slate-50 dark:bg-slate-800/50 border-b dark:border-slate-800 text-slate-500 text-[10px] font-bold uppercase">
              <tr>
                <th className="p-4 text-center">Cód (ID)</th>
                <th className="p-4">Nome da Unidade</th>
                <th className="p-4 text-center">Sigla</th>
                <th className="p-4 text-right">Ação</th>
              </tr>
            </thead>
            <tbody className="divide-y dark:divide-slate-800">
              {sedes.map((s) => (
                <tr
                  key={s.id}
                  className="hover:bg-slate-50 dark:hover:bg-slate-800/30"
                >
                  <td className="p-4 text-center font-mono font-bold text-slate-500">
                    {s.id}
                  </td>
                  <td className="p-4 font-bold text-slate-800 dark:text-slate-200">
                    {s.nome}
                  </td>
                  <td className="p-4 text-center">
                    <span className="bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 font-black px-2 py-1 rounded-md text-[10px] uppercase">
                      {s.sigla}
                    </span>
                  </td>
                  <td className="p-4 text-right">
                    <button
                      onClick={() => deletarSede(s.id, s.nome)} // ✅ Passando o nome agora
                      className="text-red-500 hover:bg-red-50 dark:hover:bg-red-900/30 p-2 rounded-lg transition-all"
                    >
                      <Trash2 size={18} />
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/app/dashboard/admin/GestaoUsuarios.tsx">
"use client";

import { useState, useEffect } from "react";
import { supabase } from "@/lib/supabase";
import { useAuth } from "@/context/AuthContext";
import { registrarLog } from "@/lib/audit"; // ✅ Adicionado
import Swal from "sweetalert2";
import { Users, UserCog, X, Save, Loader2, Trash2 } from "lucide-react";

export default function GestaoUsuarios({ sedes }: { sedes: any[] }) {
  const { user: usuarioLogado } = useAuth();
  const nomeAdmin =
    usuarioLogado?.user_metadata?.full_name ||
    usuarioLogado?.user_metadata?.name ||
    "Administrador"; // ✅ Adicionado

  const [usuarios, setUsuarios] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [modalAberto, setModalAberto] = useState(false);
  const [editandoUser, setEditandoUser] = useState<any>(null);
  const [salvando, setSalvando] = useState(false);

  const modulosDisponiveis = [
    "alunos",
    "repouso",
    "historico",
    "ocorrencias",
    "conselho",
    "locacoes",
    "historico_locacoes",
    "admin",
    "relatorios",
    "mala_direta",
    "sorteio",
  ];

  useEffect(() => {
    carregarUsuarios();
  }, []);

  async function carregarUsuarios() {
    setLoading(true);
    const { data } = await supabase
      .from("vw_gestao_usuarios")
      .select("*")
      .order("nome");
    if (data) setUsuarios(data);
    setLoading(false);
  }

  const salvarAlteracoes = async () => {
    if (!editandoUser) return;
    setSalvando(true);
    const { error } = await supabase.from("permissoes_usuarios").upsert(
      {
        user_id: editandoUser.user_id,
        is_admin: editandoUser.is_admin,
        sedes_permitidas: editandoUser.sedes_permitidas,
        modulos_permitidos: editandoUser.modulos_permitidos,
      },
      { onConflict: "user_id" },
    );

    if (error) {
      Swal.fire("Erro", error.message, "error");
    } else {
      // ✅ LOG DE AUDITORIA (ATUALIZAÇÃO DE ACESSOS)
      const modulosTexto =
        editandoUser.modulos_permitidos?.length > 0
          ? editandoUser.modulos_permitidos.join(", ")
          : "Nenhum";

      const sedesTexto =
        editandoUser.sedes_permitidas?.length > 0
          ? editandoUser.sedes_permitidas.join(", ")
          : "Nenhuma";

      const detalhesDoLog = `Modificou acessos de '${editandoUser.nome}'. Admin: ${editandoUser.is_admin ? "SIM" : "NÃO"} | Módulos: [${modulosTexto}] | IDs das Sedes: [${sedesTexto}]`;

      await registrarLog(nomeAdmin, "ATUALIZAÇÃO DE PERMISSÕES", detalhesDoLog);

      setModalAberto(false);
      carregarUsuarios();
      Swal.fire("Salvo!", "Acessos atualizados.", "success");
    }
    setSalvando(false);
  };

  const excluirUsuario = async (id: string, nome: string) => {
    if (id === usuarioLogado?.id) {
      return Swal.fire(
        "Atenção",
        "Você não pode excluir a sua própria conta.",
        "warning",
      );
    }

    const { isConfirmed } = await Swal.fire({
      title: "Exclusão Permanente",
      text: `Tem certeza que deseja apagar o usuário ${nome}? Todo o acesso dele será revogado e a conta será deletada do Bando de Dados.`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#dc2626",
      cancelButtonColor: "#64748b",
      confirmButtonText: "Sim, Excluir!",
      cancelButtonText: "Cancelar",
    });

    if (isConfirmed) {
      Swal.fire({
        title: "Apagando...",
        text: "Processando a exclusão no servidor.",
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        const response = await fetch("/api/usuarios", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            userIdParaDeletar: id,
            adminId: usuarioLogado?.id,
          }),
        });

        const data = await response.json();

        if (data.success) {
          // ✅ LOG DE AUDITORIA (EXCLUSÃO DE CONTA)
          await registrarLog(
            nomeAdmin,
            "EXCLUSÃO DE USUÁRIO",
            `Removeu permanentemente o usuário '${nome}' (ID: ${id}) do sistema.`,
          );

          Swal.fire(
            "Excluído!",
            "O usuário foi removido permanentemente.",
            "success",
          );
          carregarUsuarios();
        } else {
          throw new Error(data.error);
        }
      } catch (err: any) {
        Swal.fire("Erro na Exclusão", err.message, "error");
      }
    }
  };

  if (loading)
    return (
      <div className="text-center p-10 font-bold text-slate-400 animate-pulse">
        Carregando usuários...
      </div>
    );

  return (
    <div className="space-y-4">
      <h2 className="text-lg font-black uppercase text-slate-800 dark:text-slate-200 flex items-center gap-2 mb-6">
        <Users className="text-blue-500" /> Contas Habilitadas
      </h2>

      <div className="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl">
        <table className="w-full text-left text-[11px] min-w-[600px]">
          <thead className="bg-slate-50 dark:bg-slate-800/50 border-b dark:border-slate-800 text-slate-500 font-bold uppercase">
            <tr>
              <th className="p-4">Colaborador</th>
              <th className="p-4 text-center">Tipo</th>
              <th className="p-4">Módulos</th>
              <th className="p-4 text-right">Ações</th>
            </tr>
          </thead>
          <tbody className="divide-y dark:divide-slate-800 text-slate-900 dark:text-slate-300">
            {usuarios.map((u) => (
              <tr
                key={u.user_id}
                className="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors"
              >
                <td className="p-4">
                  <div className="font-bold text-slate-900 dark:text-slate-100">
                    {u.nome}
                  </div>
                  <div className="text-slate-500 dark:text-slate-400 font-mono text-[10px]">
                    {u.email}
                  </div>
                </td>
                <td className="p-4 text-center font-black text-slate-900 dark:text-slate-100">
                  {u.is_admin ? "ADMIN" : "USER"}
                </td>

                <td className="p-4">
                  <div className="flex flex-wrap gap-1">
                    {u.modulos_permitidos?.map((m: any) => (
                      <span
                        key={m}
                        className="bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase border border-blue-200 dark:border-blue-800/50"
                      >
                        {m.replace("_", " ")}
                      </span>
                    ))}
                    {(!u.modulos_permitidos ||
                      u.modulos_permitidos.length === 0) && (
                      <span className="text-[9px] font-bold text-slate-400 italic">
                        Nenhum acesso
                      </span>
                    )}
                  </div>
                </td>

                <td className="p-4 text-right">
                  <div className="flex items-center justify-end gap-2">
                    <button
                      onClick={() => {
                        setEditandoUser({ ...u });
                        setModalAberto(true);
                      }}
                      className="bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 px-4 py-2 rounded-lg text-[10px] hover:bg-blue-600 hover:text-white uppercase font-black transition-all"
                    >
                      Configurar
                    </button>
                    <button
                      onClick={() => excluirUsuario(u.user_id, u.nome)}
                      title="Excluir Usuário"
                      className="bg-red-50 text-red-600 dark:bg-red-900/20 dark:text-red-400 p-2 rounded-lg hover:bg-red-600 hover:text-white transition-all shadow-sm"
                    >
                      <Trash2 size={16} />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {modalAberto && (
        <div className="fixed inset-0 bg-black/60 flex justify-center sm:justify-end z-[999] animate-in fade-in backdrop-blur-sm p-0">
          <div className="w-full sm:max-w-md bg-white dark:bg-slate-900 h-full p-4 sm:p-6 shadow-2xl flex flex-col animate-in slide-in-from-right duration-300">
            <div className="flex justify-between items-center border-b dark:border-slate-700 pb-4 mb-4">
              <div className="flex items-center gap-2">
                <UserCog
                  size={24}
                  className="text-blue-600 dark:text-blue-500"
                />
                <h2 className="text-lg font-black uppercase text-slate-900 dark:text-slate-200">
                  Acessos do Usuário
                </h2>
              </div>
              <button
                onClick={() => setModalAberto(false)}
                className="hover:bg-red-500 hover:text-white p-2 rounded-full text-slate-500 dark:text-slate-400 transition-colors"
              >
                <X size={24} />
              </button>
            </div>
            <div className="flex-1 overflow-y-auto space-y-6">
              <div className="p-4 bg-slate-100 dark:bg-slate-800 rounded-lg">
                <p className="text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase">
                  Colaborador
