    color: #e2e8f0;
  }
  .dark .ql-snow .ql-active .ql-stroke {
    stroke: #3b82f6;
  }
`;

// Carregamento dinâmico com cast 'as any' para evitar erro de build na Ref
const ReactQuill = dynamic(() => import("react-quill-new"), {
  ssr: false,
  loading: () => (
    <div className="h-[250px] bg-slate-50 animate-pulse rounded-xl" />
  ),
}) as any;

export default function MalaDiretaPage() {
  const { coligadaAtual } = useColigada();
  const [etapa, setEtapa] = useState(1);
  const [origem, setOrigem] = useState<"banco" | "planilha" | null>(null);
  const [disparando, setDisparando] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [gerandoIA, setGerandoIA] = useState(false); // ✅ Estado de loading da IA

  const [anexo, setAnexo] = useState<{ nome: string; conteudo: string } | null>(
    null,
  );
  const anexoRef = useRef<HTMLInputElement>(null);
  const arquivoRef = useRef<HTMLInputElement>(null);
  const quillRef = useRef<any>(null); // Ref para o editor Quill

  const [contatos, setContatos] = useState<any[]>([]);
  const [tags, setTags] = useState<string[]>([]);
  const [assunto, setAssunto] = useState("");
  const [mensagem, setMensagem] = useState("");

  const modulosQuill = {
    toolbar: [
      ["bold", "italic", "underline"],
      [{ list: "ordered" }, { list: "bullet" }],
      [{ align: [] }],
      ["clean"],
    ],
  };

  // ✅ Função que chama o Gemini via Rota da API
  const handleGerarComIA = async () => {
    const { value: instrucao } = await Swal.fire({
      title: "Assistente IA",
      input: "text",
      inputLabel: "Ex: Escreva um convite para a reunião de pais",
      inputPlaceholder: "O que você quer que a IA faça?",
      showCancelButton: true,
      confirmButtonText: "Gerar Texto",
      cancelButtonText: "Cancelar",
      confirmButtonColor: "#8b5cf6", // Roxo para dar cara de IA
    });

    if (instrucao) {
      setGerandoIA(true);
      try {
        const res = await fetch("/api/gemini", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt: instrucao, textoAtual: mensagem }),
        });

        const data = await res.json();

        if (data.success) {
          // Substitui o texto do editor pelo que a IA gerou
          setMensagem(data.text);
          Swal.fire({
            title: "Pronto!",
            text: "Texto gerado com sucesso.",
            icon: "success",
            toast: true,
            position: "top-end",
            timer: 2000,
            showConfirmButton: false,
          });
        } else {
          throw new Error(data.error);
        }
      } catch (err: any) {
        Swal.fire("Erro na IA", err.message, "error");
      } finally {
        setGerandoIA(false);
      }
    }
  };

  // FUNÇÃO: Inserir tag na posição exata do cursor
  const inserirTagNoCursor = (tag: string) => {
    const quill = quillRef.current?.getEditor();
    if (quill) {
      const range = quill.getSelection();
      const textoTag = `{{${tag}}}`;
      if (range) {
        quill.insertText(range.index, textoTag);
        quill.setSelection(range.index + textoTag.length);
      } else {
        const length = quill.getLength();
        quill.insertText(length - 1, textoTag);
      }
    }
  };

  const processarArquivo = (file: File) => {
    const isExcel = file.name.endsWith(".xlsx") || file.name.endsWith(".xls");
    if (isExcel) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const data = e.target?.result;
        const workbook = XLSX.read(data, { type: "binary" });
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        const json = XLSX.utils.sheet_to_json(worksheet);
        if (json.length === 0)
          return Swal.fire("Erro", "A planilha está vazia.", "error");
        setContatos(json);
        setTags(Object.keys(json[0] as object));
        setEtapa(2);
      };
      reader.readAsBinaryString(file);
    } else {
      Papa.parse(file, {
        header: true,
        skipEmptyLines: true,
        complete: (results) => {
          if (results.data.length === 0)
            return Swal.fire("Erro", "A planilha está vazia.", "error");
          setContatos(results.data);
          setTags(results.meta.fields || []);
          setEtapa(2);
        },
      });
    }
  };

  const handleSelecionarAnexo = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = () => {
      const base64String = (reader.result as string).split(",")[1];
      setAnexo({ nome: file.name, conteudo: base64String });
    };
  };

  const handleDispararEmails = async () => {
    if (contatos.length === 0) return;
    const result = await Swal.fire({
      title: "Confirmar Disparo?",
      text: `Você enviará e-mails para ${contatos.length} destinatários.`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#16a34a",
      confirmButtonText: "Sim, disparar!",
    });
    if (!result.isConfirmed) return;
    setDisparando(true);
    try {
      const response = await fetch("/api/mala-direta", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contatos, assunto, mensagem, tags, anexo }),
      });
      const data = await response.json();
      if (data.success) {
        Swal.fire(
          "Concluído!",
          `${data.enviados} e-mails enviados.`,
          "success",
        );
        setEtapa(1);
        setContatos([]);
        setAssunto("");
        setMensagem("");
        setAnexo(null);
        setOrigem(null);
      } else {
        throw new Error(data.error);
      }
    } catch (error: any) {
      Swal.fire("Erro", error.message, "error");
    } finally {
      setDisparando(false);
    }
  };

  return (
    <div className="bg-slate-50 dark:bg-slate-950 min-h-screen flex flex-col font-sans">
      <style>{quillStyle}</style>

      {/* HEADER */}
      <div className="bg-white dark:bg-slate-900 p-6 border-b border-slate-200 dark:border-slate-800 flex items-center gap-4">
        <Link
          href="/dashboard"
          className="p-2 bg-slate-100 dark:bg-slate-800 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
        >
          <ArrowLeft size={20} />
        </Link>
        <div>
          <h1 className="text-2xl font-black text-slate-800 dark:text-slate-100 flex items-center gap-2 uppercase tracking-tight">
            <Send className="text-blue-600 dark:text-blue-400" /> Mala Direta
          </h1>
          <p className="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">
            Unidade:{" "}
            <span className="text-blue-600 dark:text-blue-400">
              {coligadaAtual?.nome}
            </span>
