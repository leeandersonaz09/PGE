                    );
                  })}
                </td>
              </tr>
            </tbody>

            <tfoot>
              <tr>
                <td>
                  <div className="mt-6 pt-4 border-t-2 border-slate-300 text-center">
                    <p className="text-[8px] text-slate-600 font-bold uppercase tracking-widest">
