                    className="bg-transparent outline-none ml-1 w-48"
                  />
                </td>
                <td className="p-[4px_6px] border-l-0 text-left">
                  <span className="font-bold uppercase">NASCIMENTO :</span>{" "}
                  <input
                    type="text"
                    value={dadosPessoais.nascimento}
